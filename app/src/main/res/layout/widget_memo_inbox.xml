<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_memo_widget">
    <TextView android:id="@+id/memo_widget_title" android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:text="@string/memo_title" android:textStyle="bold" android:textSize="17sp" android:textColor="#1B1E28" android:contentDescription="@string/memo_title" />
    <LinearLayout android:id="@+id/memo_widget_row1" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical">
        <CheckBox android:id="@+id/memo_widget_check1" android:layout_width="44dp" android:layout_height="44dp" android:buttonTint="#626AD1" android:contentDescription="@string/memo_title" />
        <TextView android:id="@+id/memo_widget_text1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:textColor="#1B1E28" android:textSize="14sp" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/memo_widget_row2" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical">
        <CheckBox android:id="@+id/memo_widget_check2" android:layout_width="44dp" android:layout_height="44dp" android:buttonTint="#626AD1" android:contentDescription="@string/memo_title" />
        <TextView android:id="@+id/memo_widget_text2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:textColor="#1B1E28" android:textSize="14sp" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/memo_widget_row3" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical">
        <CheckBox android:id="@+id/memo_widget_check3" android:layout_width="44dp" android:layout_height="44dp" android:buttonTint="#626AD1" android:contentDescription="@string/memo_title" />
        <TextView android:id="@+id/memo_widget_text3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:textColor="#1B1E28" android:textSize="14sp" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/memo_widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#555968" android:textSize="14sp" android:text="@string/memo_widget_empty" />
</LinearLayout>
