<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Eta Ultra 标记：外环收拢、内环断开、中心点；几何线条，与开屏动画同源。 -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.0"
        android:scaleY="1.0">
        <!-- 外环：从 -90° 起 300°，留出右上缺口，暗示“持续运行”。 -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FF3482FF"
            android:strokeWidth="5.5"
            android:strokeLineCap="round"
            android:pathData="M54,24 A30,30 0 1,1 30.02,69" />
        <!-- 内环：反向 200°，形成层次。 -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FF3482FF"
            android:strokeAlpha="0.55"
            android:strokeWidth="3.2"
            android:strokeLineCap="round"
            android:pathData="M54,38 A16,16 0 1,0 70,54" />
        <!-- 中心点：视觉落点。 -->
        <path
            android:fillColor="#FF3482FF"
            android:pathData="M54,50 m-4.6,0 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0" />
    </group>
</vector>
