/local.properties
/.analysis/
/.tmp/

# 外部源码参考，仅供阅读，不参与当前仓库版本管理
/reference/

# 版本号/构建脚本留在本地的备份
*.bak

# 本地构建工具脚本与下载辅助文件
/.eta-tools/
