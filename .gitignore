*.iml
/.idea/

# Gradle / Kotlin 构建缓存
/.gradle/
/.kotlin/
**/build/
/dist/
__pycache__/

# Android 构建产物
.cxx/
.externalNativeBuild/
/app/release/
captures/
*.apk
*.aab
output-metadata.json
*.hprof

